# Google OAuth client id (real login). Leave blank for the dev email sign-in;
# that only works when the backend runs with GOOGLE_OAUTH_CLIENT_ID empty and DEV_LOGIN=1.
# kya dikkat h vercel ko, itni baar code kyu mangta
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Base URL for the API. Blank = same-origin (/api proxied by Vite in dev, rewritten by Vercel in prod).
VITE_API_BASE=
